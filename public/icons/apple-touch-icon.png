<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1B2A4A" />
      <stop offset="100%" stop-color="#0F1B30" />
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5ECCE" />
      <stop offset="50%" stop-color="#C9A84C" />
      <stop offset="100%" stop-color="#A07B2F" />
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="110" fill="url(#bg)"/>
  <rect x="20" y="20" width="472" height="472" rx="90" fill="none" stroke="url(#gold)" stroke-width="4" stroke-opacity="0.4"/>
  <!-- Pillar & Scales of Justice -->
  <g transform="translate(256, 256)" stroke="url(#gold)" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- Center Column -->
    <path d="M0, -140 L0, 140" stroke-width="16" />
    <!-- Pedestal Base -->
    <path d="M-80, 140 L80, 140 M-60, 120 L60, 120" stroke-width="14" />
    <!-- Top Finial -->
    <circle cx="0" cy="-148" r="16" fill="url(#gold)" stroke="none" />
    <!-- Cross Beam -->
    <path d="M-150, -90 L150, -90" stroke-width="14" />
    <!-- Left Scale strings & Pan -->
    <path d="M-150, -90 L-190, -10 M-150, -90 L-110, -10" stroke-width="6" />
    <path d="M-210, -10 Q-150, 45 -90, -10 Z" fill="url(#gold)" fill-opacity="0.25" stroke-width="8" />
    <!-- Right Scale strings & Pan -->
    <path d="M150, -90 L110, -10 M150, -90 L190, -10" stroke-width="6" />
    <path d="M90, -10 Q150, 45 210, -10 Z" fill="url(#gold)" fill-opacity="0.25" stroke-width="8" />
    <!-- Law Book at Base -->
    <path d="M-60, 70 C-20, 60 0, 75 0, 75 C0, 75 20, 60 60, 70 L60, 105 C20, 95 0, 110 0, 110 C0, 110 -20, 95 -60, 105 Z" fill="url(#gold)" fill-opacity="0.4" stroke-width="6" />
  </g>
</svg>
